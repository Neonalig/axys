# Axys never contacts a network service, so the policy can be closed down hard.
# blob: covers the worker and worklet module URLs the bundler emits.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

# Cross-origin isolation is OPTIONAL. Axys works without it and uses neither
# SharedArrayBuffer nor WASM threads. Uncommenting these enables isolation for
# future measurement, at the cost of blocking non-CORP cross-origin subresources.
#/*
#  Cross-Origin-Embedder-Policy: require-corp
#  Cross-Origin-Resource-Policy: same-origin
