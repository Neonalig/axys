{
  "name": "axys",
  "version": "0.1.0",
  "description": "Local-first monophonic vocal pitch and timing editor",
  "license": "AGPL-3.0-or-later",
  "author": "Neonalig",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel wasm:watch dev:web",
    "dev:web": "vite",
    "wasm:build": "node scripts/build-wasm.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "music:build": "node scripts/build-music-font.mjs",
    "wasm:watch": "node scripts/build-wasm.mjs --watch",
    "build": "npm run wasm:build && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "npm run test:rust && npm run test:web",
    "test:rust": "cargo test --workspace",
    "test:web": "vitest run",
    "lint": "npm run lint:web && npm run lint:rust",
    "lint:web": "eslint . && prettier --check .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "check": "npm run check:rust && npm run check:web && npm run test",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check:web": "tsc --noEmit -p tsconfig.json && eslint . && prettier --check . && node scripts/build-icons.mjs --check && node scripts/build-music-font.mjs --check",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.0",
    "eslint": "^9.13.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wasm-pack": "^0.13.1"
  }
}
